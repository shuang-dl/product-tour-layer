{
  "id": "receive-a-payment",
  "title": "Receive a Payment",
  "page": "/home",
  "style": {
    "frame": "#0b1f44",
    "bandText": "#ffffff",
    "button": "#d8f34a",
    "buttonText": "#0b1f44",
    "bodyText": "#1b1d21",
    "bodyBg": "#ffffff",
    "headerHeight": 26,
    "footerHeight": 48,
    "sideBorder": 3,
    "corners": 10,
    "titleSize": "h2",
    "titleAlign": "left",
    "textAlign": "left"
  },
  "exitClicks": [
    "button[data-slot='takeover-dialog-close']",
    {
      "text": "Discard changes",
      "selector": "button"
    }
  ],
  "steps": [
    {
      "target": "[data-cy='SideMenu-CreateNewMenu-Button']",
      "title": "Create New",
      "text": "Create new is the all in one quick short cut for creating anything new in DoorLoop. We will be using this to receive a new payment.",
      "advanceOn": "click"
    },
    {
      "target": "button[data-section-value='transactions']",
      "title": "Transactions Section",
      "text": "Click the Transactions Section.",
      "advanceOn": "click"
    },
    {
      "target": "[data-item-id='receive-payment']",
      "title": "Receive Payment",
      "text": "Click receive pay to begin.",
      "advanceOn": "click"
    },
    {
      "page": "/home/global-new/payment/new",
      "target": "[data-cy='lease-payment-dialog-lease']",
      "title": "Select a Lease",
      "text": "Select the lease related to the payment.",
      "advanceOn": "click"
    },
    {
      "page": "/home/global-new/payment/new",
      "target": "[data-cy='lease-payment-dialog-lease-option']",
      "title": "Select a lease",
      "text": "click on an existing lease",
      "advanceOn": "click"
    },
    {
      "page": "/home/global-new/payment/new",
      "target": "[data-cy='lease-payment-dialog-received-from']",
      "title": "Click to Select a Tenant",
      "text": "Open the list of tenants on this lease.",
      "advanceOn": "click"
    },
    {
      "page": "/home/global-new/payment/new",
      "target": "[data-cy='lease-payment-dialog-received-from-option-6a7e3c7d4adb321ec4bec469']",
      "title": "Select a tenant",
      "text": "Pick the tenant who made the payment.",
      "advanceOn": "click"
    },
    {
      "page": "/home/global-new/payment/new",
      "target": "[data-cy='lease-payment-dialog-amount']",
      "title": "Amount",
      "text": "Enter the amount received",
      "fill": [
        {
          "target": "[data-cy='lease-payment-dialog-amount']",
          "value": "$1500.00"
        }
      ]
    },
    {
      "page": "/home/global-new/payment/new",
      "target": "[data-cy='lease-payment-dialog-save']",
      "title": "Create Payment",
      "text": "Click this to finish receiving the payment",
      "showOnly": true
    }
  ]
}

