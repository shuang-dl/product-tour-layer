{
  "id": "wallet-transfers",
  "title": "Wallet Transfers",
  "status": "draft",
  "page": "/home",
  "style": {
    "frame": "#0b1f44",
    "bandText": "#ffffff",
    "button": "#d8f34a",
    "buttonText": "#0b1f44",
    "bodyText": "#1b1d21",
    "bodyBg": "#ffffff",
    "titleSize": "h2",
    "titleAlign": "left",
    "textAlign": "left"
  },
  "steps": [
    {
      "target": {
        "text": "DoorLoop Wallet",
        "selector": "a"
      },
      "clues": {
        "tag": "a",
        "text": "DoorLoop Wallet",
        "role": "a",
        "href": "/wallets"
      },
      "title": "Click “DoorLoop Wallet”",
      "text": "Click DoorLoop Wallet.",
      "advanceOn": "click"
    },
    {
      "page": "/wallets",
      "target": "[data-testid='WalletsList-TransferFunds']",
      "clues": {
        "tag": "button",
        "text": "Transfer funds",
        "role": "button"
      },
      "title": "Click “Transfer funds”",
      "text": "Click Transfer funds.",
      "advanceOn": "click"
    },
    {
      "page": "/wallets",
      "target": "input#wallet-movement-amount",
      "clues": {
        "tag": "input",
        "placeholder": "0.00",
        "role": "input"
      },
      "title": "Enter Amount",
      "text": "Type Amount.",
      "fill": [
        {
          "target": "input#wallet-movement-amount",
          "clues": {
            "tag": "input",
            "placeholder": "0.00",
            "role": "input"
          },
          "value": "1000"
        }
      ]
    },
    {
      "page": "/wallets",
      "target": "[data-testid='WalletMovement-Memo']",
      "clues": {
        "tag": "textarea",
        "role": "textarea"
      },
      "title": "Add a memo",
      "text": "Add a short note about this transfer (up to 80 characters).",
      "fill": [
        {
          "target": "[data-testid='WalletMovement-Memo']",
          "clues": {
            "tag": "textarea",
            "role": "textarea"
          },
          "value": "Transfer to bank"
        }
      ]
    },
    {
      "page": "/wallets",
      "target": "[data-testid='WalletMovement-Authorize']",
      "clues": {
        "tag": "button",
        "role": "checkbox"
      },
      "title": "Authorize the withdrawal",
      "text": "Tick “I authorize this withdrawal from the selected wallet.”"
    },
    {
      "page": "/wallets",
      "target": "[data-testid='WalletMovement-Submit']",
      "clues": {
        "tag": "button",
        "text": "Withdraw",
        "role": "button"
      },
      "title": "Click Withdraw when ready.",
      "text": "Withdraw to finish",
      "showOnly": true
    }
  ]
}
