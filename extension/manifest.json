{
  "manifest_version": 3,
  "name": "DoorLoop Product Tours",
  "version": "0.22.0",
  "description": "Guided product tours on top of DoorLoop. Internal proof of concept.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "DoorLoop Tours",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.app.doorloop.com/*",
    "https://github.com/*",
    "https://api.github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.app.doorloop.com/*"
      ],
      "exclude_matches": [
        "https://app.doorloop.com/*"
      ],
      "js": [
        "driver.js.iife.js",
        "tour-layer.js",
        "bundled-tours.js",
        "builder.js",
        "gif.js",
        "export.js",
        "content.js"
      ],
      "css": [
        "driver.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
